{
  "name": "nebenwirkungen-cardgame",
  "version": "0.1.2",
  "description": "Nebenwirkungen card game prototype",
  "author": "Nebenwirkungen",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "tsx server/index.ts",
    "server": "tsx server/index.ts",
    "test:logic": "tsx tools/check-game-logic.ts",
    "build": "tsc && vite build",
    "desktop": "npm run build && electron desktop/main.cjs",
    "desktop:pack": "npm run build && electron-builder --win portable",
    "desktop:installer": "npm run build && electron-builder --win nsis",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "electron-updater": "^6.8.3",
    "pixi.js": "^8.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "electron": "^42.3.2",
    "electron-builder": "^26.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "de.nebenwirkungen.cardgame",
    "productName": "Nebenwirkungen",
    "directories": {
      "output": "desktop/release"
    },
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "MiMMiMANiAC",
        "repo": "online-mp-drug-cardgame"
      }
    ],
    "files": [
      "dist/**/*",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
